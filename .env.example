# Personal AI Agent OS — secrets template (plan §17G, §22)
#
# Copy this file to D:\Personal-Agent\secrets\.env and fill in real values there.
# The real .env must NEVER be committed. Only secrets go here; all non-secret
# configuration belongs in config/*.yaml.

# Telegram (Phase 2)
TELEGRAM_BOT_TOKEN=
# Comma-separated exact chat_id whitelist
TELEGRAM_ALLOWED_CHAT_IDS=

# Internal worker RPC bearer token: NOT set here. It is generated automatically
# in <secrets_dir>/internal_rpc.token and rotated with scripts/rotate_rpc_token.py.

# Optional API-billed providers (disabled unless explicitly configured)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# WhatsApp (Phase 21) — comma-separated allowed phone numbers
WHATSAPP_ALLOWED_NUMBERS=

# Optional TOTP secret for high-risk admin confirmation (plan §17D)
ADMIN_TOTP_SECRET=
