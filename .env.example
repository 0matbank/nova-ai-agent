# Personal AI Agent OS — secrets template (plan §17G, §22)
#
# Copy this file to D:\Personal-Agent\secrets\.env and fill in real values there.
# The real .env must NEVER be committed. Only secrets go here; all non-secret
# configuration belongs in config/*.yaml.

# Telegram (Phase 2)
TELEGRAM_BOT_TOKEN=
# Comma-separated exact chat_id whitelist
TELEGRAM_ALLOWED_CHAT_IDS=

# Internal worker RPC bearer token: NOT set here. It is generated automatically
# in <secrets_dir>/internal_rpc.token and rotated with scripts/rotate_rpc_token.py.

# Optional API-billed providers (disabled unless explicitly configured)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# WhatsApp (Phase 21, official Cloud API — see docs/WHATSAPP.md)
# Your own WhatsApp number(s) with country code, e.g. 8801XXXXXXXXX (comma-separated)
WHATSAPP_ALLOWED_NUMBERS=
# Meta app → WhatsApp → API Setup: the TEST number's "Phone number ID" and
# "WhatsApp Business Account ID"
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# A permanent System User access token (whatsapp_business_messaging +
# whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
# Meta app → Settings → Basic: App ID and App Secret (webhook signatures)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# The webhook verify token is NOT set here: Nova generates it in
# <secrets_dir>/whatsapp_verify.token.

# Optional TOTP secret for high-risk admin confirmation (plan §17D)
ADMIN_TOTP_SECRET=
